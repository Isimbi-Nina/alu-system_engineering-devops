#!/usr/bin/env bash
# Installs nginx with a 301 redirection and a custom 404 page
apt-get update
apt-get install -y nginx
echo "Holberton School for the win!" > /var/www/html/index.html
echo "Ceci n'est pas une page" > /var/www/html/404.html
sed -i 's#server_name _;#server_name _;\n\terror_page 404 /404.html;\n\tlocation /redirect_me {\n\t\treturn 301 https://www.youtube.com/watch?v=QH2-TGUlwu4;\n\t}#' /etc/nginx/sites-available/default
service nginx restart
